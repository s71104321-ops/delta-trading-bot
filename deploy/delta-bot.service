[Unit]
Description=Delta options basket bot
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/home/bot/delta-trading-bot
EnvironmentFile=/home/bot/delta-trading-bot/.env
ExecStart=/home/bot/delta-trading-bot/.venv/bin/python -m bot.main run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target

# Copy to .env on the server (cp .env.example .env) and fill in. NEVER commit .env to GitHub.

# testnet = fake money (default). live needs LIVE_TRADING_CONFIRM too.
DELTA_ENV=testnet
# LIVE_TRADING_CONFIRM=I_ACCEPT_REAL_MONEY_RISK

# Delta API key: trading permission ONLY, never withdrawal. Whitelist your droplet's IP.
DELTA_API_KEY=
DELTA_API_SECRET=

# true = only log what it would do. Set false to place real orders on testnet.
DRY_RUN=true

UNDERLYING=BTC
# none = no automatic trades. trend_portfolio = BTC trend + ETH breakout, long only (the tested strategy)
STRATEGY=none
TREND_COINS=BTCUSD:trend,ETHUSD:breakout
# 1 = no leverage: total position value = account balance, split 50/50
TREND_LEVERAGE=1
# flatten everything + kill switch if today's loss is bigger than this % of the balance
MAX_DAILY_LOSS_PCT=10

# Risk limits
MAX_CONTRACTS_PER_LEG=5
MAX_OPEN_BASKETS=2
MAX_DAILY_LOSS_USD=50
MAX_LOSS_PER_BASKET_USD=25
MAX_LOSS_PCT_OF_PREMIUM=50
MAX_PREMIUM_PER_BASKET_USD=100
MAX_SPREAD_PCT=15

# Futures (BTCUSD perpetual) — every trade has a stop; size is worked out from the risk
RISK_PER_TRADE_USD=5
MAX_FUTURES_CONTRACTS=50
MAX_LEVERAGE=3
MAX_OPEN_FUTURES=1
MAX_FUNDING_PCT=0.05
DRY_RUN_EQUITY_USD=500

POLL_SECONDS=30

# Telegram alerts (optional): create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
